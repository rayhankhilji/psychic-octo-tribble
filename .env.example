# Copy to .env and fill in what you have. Everything is optional: with
# nothing set, TinyTown runs the demo world. Full walkthrough: docs/SETUP.md.
# Never commit .env, and never paste secret keys into chat.

# ─── Local mode (your own data, no accounts) ───────────────────────────────
# Used only while Supabase below is NOT configured.

# Shown on your HQ's neon sign.
TINYTOWN_NAME=Your Startup
# Stripe: a RESTRICTED key with read-only access to Subscriptions. Never a full secret key.
STRIPE_SECRET_KEY=
# GitHub: owner/repo whose releases and commits drive your HQ.
GITHUB_REPO=
# Optional for public repos; needed for private ones (fine-grained, read-only Contents).
GITHUB_TOKEN=

PORT=8787

# ─── Hosted mode: the app ──────────────────────────────────────────────────

# Public address of the app, no trailing slash (https in production). OAuth
# redirect URIs and Stripe return URLs are built from it. On Vercel it falls
# back to the production domain.
APP_URL=http://localhost:5173

# ─── Supabase (accounts and saves). Setting all three turns hosted mode on ─

# Project URL, e.g. https://abcd1234.supabase.co (public)
SUPABASE_URL=
# The anon / publishable key (public: the browser uses it to sign in)
SUPABASE_ANON_KEY=
# The service_role / secret key (SECRET: full database access, server only)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Our secrets (generate each with: openssl rand -base64 32) ─────────────

# Encrypts founders' Stripe refresh tokens and PostHog keys at rest. To rotate, move the
# current key to TOKEN_ENCRYPTION_KEY_OLD and set a new one (docs/SECURITY.md).
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_OLD=
# Signs the OAuth "state" for Stripe and GitHub connections.
STATE_SECRET=

# ─── Billing: TinyTown's own Stripe account ────────────────────────────────

# Secret key (sk_live_… / sk_test_…) or a restricted key with Checkout, Customers,
# Customer portal and Subscriptions access (SECRET)
STRIPE_BILLING_SECRET_KEY=
# Signing secret of the webhook endpoint …/api/billing/webhook (SECRET, whsec_…)
STRIPE_WEBHOOK_SECRET=
# The price id of the $29/year price (price_…). TinyTown is sold by the year only.
# `node tools/stripe-setup.mjs` creates it and prints this value.
STRIPE_PRICE_YEARLY=
# Leave unset. Only for selling a monthly plan as well (none is sold now); anyone
# already on the old $12/month price is still recognised without it.
STRIPE_PRICE_MONTHLY=
# Customer portal configuration made by stripe-setup (bpc_…). Optional.
STRIPE_PORTAL_CONFIGURATION=
# 1 = Stripe Tax in Checkout (register in Stripe → Settings → Tax first)
STRIPE_AUTOMATIC_TAX=
# 1 = buyers must tick the Terms, with the "renews automatically, non-refundable" line
# (set the Terms URL in Stripe → Settings → Public details first)
STRIPE_TERMS_CONSENT=
# 1 = show a promotion code box in Checkout
STRIPE_PROMO_CODES=
# Checkout shows the price in the buyer's local currency (Stripe Adaptive Pricing).
# On by default; 0 = always charge in USD.
STRIPE_ADAPTIVE_PRICING=
# Optional override of the pinned Stripe API version
STRIPE_API_VERSION=

# ─── Founders' Stripe: the TinyTown Stripe App (OAuth) ─────────────────────

# The app's client id from its Settings page in the Stripe Dashboard (ca_…)
STRIPE_APP_CLIENT_ID=
# Full secret key of the account that owns the app (not a restricted key). Its
# mode (live/test) must match the install link. Defaults to STRIPE_BILLING_SECRET_KEY.
STRIPE_APP_SECRET_KEY=
# Optional: the authorize link from the app's "External test" tab while testing.
# Defaults to https://marketplace.stripe.com/oauth/v2/authorize
STRIPE_APP_INSTALL_URL=
# 1 = let test-mode Stripe data drive the city (development only). Leave empty in production.
ALLOW_TEST_MODE=

# ─── GitHub App ────────────────────────────────────────────────────────────

# The app's URL name: github.com/apps/<slug>
GITHUB_APP_SLUG=
# App ID (a number) from the app's settings page
GITHUB_APP_ID=
# Client ID and a client secret (SECRET) from the app's settings page
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's private key (SECRET): the .pem file's contents, or the file base64-encoded on one line
GITHUB_APP_PRIVATE_KEY=

# ─── PostHog (optional population source) ──────────────────────────────────

# Founders bring their own PostHog key; it's stored encrypted. Hosts the server
# may call (comma-separated). Defaults to PostHog Cloud: us.posthog.com,eu.posthog.com
POSTHOG_HOSTS=

# ─── Launch: access, admins, support ───────────────────────────────────────

# waitlist = only invited emails (and admins, and anyone already paying) get in;
# open = anyone. Leave unset locally and on previews.
ACCESS_MODE=
# Who may open /admin.html (comma-separated emails, SECRET-ish: keep it server-side)
ADMIN_EMAILS=
# The console asks admins for an authenticator code (Supabase TOTP). off = don't (local testing only).
ADMIN_MFA=
# Shown in the app and on error screens
SUPPORT_EMAIL=
# Cloudflare Turnstile site key: bot check on sign-in (the secret goes in Supabase, not here)
TURNSTILE_SITE_KEY=

# ─── Email (Resend) ────────────────────────────────────────────────────────

# Sending key (SECRET). Without it and EMAIL_FROM, emails are logged and not sent.
RESEND_API_KEY=
# e.g. TinyTown <hello@mail.yourdomain.com>
EMAIL_FROM=
# Optional: a mailbox a person reads
EMAIL_REPLY_TO=
# Optional: your business address, shown in the weekly digest (CAN-SPAM)
EMAIL_POSTAL_ADDRESS=
# Optional: Stripe's no-code portal login link, for the payment-failed email
STRIPE_PORTAL_LOGIN_URL=

# ─── Scheduled jobs and health ─────────────────────────────────────────────

# Vercel Cron sends it as a bearer token (SECRET, 16+ characters: openssl rand -hex 32)
CRON_SECRET=
# Bearer token for /api/health?deep=1 (SECRET); CRON_SECRET also works
HEALTH_SECRET=
# off = leave out the hourly cron (Vercel Hobby rejects it). Build-time.
CRON_HOURLY=
# warn = deploy even if the env check finds problems. Build-time.
ENV_CHECK=

# ─── Monitoring (all optional) ─────────────────────────────────────────────

# Sentry project DSN: server and browser error reports
SENTRY_DSN=
SENTRY_SAMPLE_RATE=
SENTRY_ENVIRONMENT=
# TinyTown's own product analytics in PostHog (phc_… is write-only)
POSTHOG_PROJECT_KEY=
POSTHOG_CAPTURE_HOST=
# Build name; defaults to the commit Vercel is building
RELEASE=
