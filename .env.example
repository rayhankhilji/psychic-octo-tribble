# Copy to .env and fill in what you have. Everything is optional: with
# nothing set, TinyTown runs the demo world. Full walkthrough: docs/SETUP.md.
# Never commit .env, and never paste secret keys into chat.

# ─── Local mode (your own data, no accounts) ───────────────────────────────
# Used only while Supabase below is NOT configured.

# Shown on your HQ's neon sign.
TINYTOWN_NAME=Your Startup
# Stripe: a RESTRICTED key with read-only access to Subscriptions. Never a full secret key.
STRIPE_SECRET_KEY=
# GitHub: owner/repo whose releases and commits drive your HQ.
GITHUB_REPO=
# Optional for public repos; needed for private ones (fine-grained, read-only Contents).
GITHUB_TOKEN=

PORT=8787

# ─── Hosted mode: the app ──────────────────────────────────────────────────

# Public address of the app, no trailing slash (https in production). OAuth
# redirect URIs and Stripe return URLs are built from it. On Vercel it falls
# back to the production domain.
APP_URL=http://localhost:5173

# ─── Supabase (accounts and saves). Setting all three turns hosted mode on ─

# Project URL, e.g. https://abcd1234.supabase.co (public)
SUPABASE_URL=
# The anon / publishable key (public: the browser uses it to sign in)
SUPABASE_ANON_KEY=
# The service_role / secret key (SECRET: full database access, server only)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Our secrets (generate each with: openssl rand -base64 32) ─────────────

# Encrypts founders' Stripe refresh tokens and PostHog keys at rest. Changing it disconnects everyone.
TOKEN_ENCRYPTION_KEY=
# Signs the OAuth "state" for Stripe and GitHub connections.
STATE_SECRET=

# ─── Billing: TinyTown's own Stripe account ────────────────────────────────

# Secret key (sk_live_… / sk_test_…) or a restricted key with Checkout, Customers,
# Customer portal and Subscriptions access (SECRET)
STRIPE_BILLING_SECRET_KEY=
# Signing secret of the webhook endpoint …/api/billing/webhook (SECRET, whsec_…)
STRIPE_WEBHOOK_SECRET=
# Price ids for $12/month and $99/year (price_…)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ─── Founders' Stripe: the TinyTown Stripe App (OAuth) ─────────────────────

# The app's client id from its Settings page in the Stripe Dashboard (ca_…)
STRIPE_APP_CLIENT_ID=
# Full secret key of the account that owns the app (not a restricted key). Its
# mode (live/test) must match the install link. Defaults to STRIPE_BILLING_SECRET_KEY.
STRIPE_APP_SECRET_KEY=
# Optional: the authorize link from the app's "External test" tab while testing.
# Defaults to https://marketplace.stripe.com/oauth/v2/authorize
STRIPE_APP_INSTALL_URL=
# 1 = let test-mode Stripe data drive the city (development only). Leave empty in production.
ALLOW_TEST_MODE=

# ─── GitHub App ────────────────────────────────────────────────────────────

# The app's URL name: github.com/apps/<slug>
GITHUB_APP_SLUG=
# App ID (a number) from the app's settings page
GITHUB_APP_ID=
# Client ID and a client secret (SECRET) from the app's settings page
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's private key (SECRET): the .pem file's contents, or the file base64-encoded on one line
GITHUB_APP_PRIVATE_KEY=

# ─── PostHog (optional population source) ──────────────────────────────────

# Founders bring their own PostHog key; it's stored encrypted. Hosts the server
# may call (comma-separated). Defaults to PostHog Cloud: us.posthog.com,eu.posthog.com
POSTHOG_HOSTS=
