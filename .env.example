# Copy to .env and fill in what you have. Every integration is optional;
# with nothing configured TinyTown runs the demo world.

# Shown on your HQ's neon sign.
TINYTOWN_NAME=Your Startup

# Stripe: use a RESTRICTED key with read-only access to Subscriptions.
# Never use a full secret key. https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# GitHub: owner/repo whose releases and commits drive your HQ.
GITHUB_REPO=
# Optional for public repos; needed for private ones (fine-grained, read-only Contents).
GITHUB_TOKEN=

PORT=8787
