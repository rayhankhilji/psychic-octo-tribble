{
  "name": "tinytown",
  "version": "0.1.0",
  "private": true,
  "description": "Your startup, as a living world: an isometric city that grows with your real metrics.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.185.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
